    {
      "argv": [
        "<LLVM_BIN>/lld-link",
        "/DLL",
        "/Brepro",
        "/DEBUG:DWARF",
        "/ENTRY:DllMain@12",
        "/NODEFAULTLIB",
        "/SAFESEH:NO",
        "/MACHINE:X86",
        "/OUT:<PACKAGE>/repro-with-dwarf.dll",
        "<PACKAGE>/repro.obj"
      ],
      "exit": 0
    }
  ],
